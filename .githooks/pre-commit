#!/usr/bin/env bash
set -e

PLUGIN_JSON=".claude-plugin/plugin.json"

# Read current version
CURRENT=$(grep '"version"' "$PLUGIN_JSON" | sed 's/.*"version": "\([^"]*\)".*/\1/')

# Bump patch
MAJOR=$(echo "$CURRENT" | cut -d. -f1)
MINOR=$(echo "$CURRENT" | cut -d. -f2)
PATCH=$(echo "$CURRENT" | cut -d. -f3)
PATCH=$((PATCH + 1))
NEW_VERSION="${MAJOR}.${MINOR}.${PATCH}"

# Update plugin.json
sed -i "s/\"version\": \"${CURRENT}\"/\"version\": \"${NEW_VERSION}\"/" "$PLUGIN_JSON"

# Update version string in all SKILL.md files
for f in skills/*/SKILL.md; do
  sed -i "s/Claude Framework v[0-9]*\.[0-9]*\.[0-9]*/Claude Framework v${NEW_VERSION}/g" "$f"
done

git add "$PLUGIN_JSON" skills/*/SKILL.md

echo "Bumped framework to v${NEW_VERSION}"
